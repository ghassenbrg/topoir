{
  "name": "topoir-workspace",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "clean": "pnpm -r --if-present clean",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm build && pnpm typecheck && pnpm test",
    "benchmark": "tsx benchmarks/compile.mts",
    "benchmark:references": "tsx benchmarks/reference-quality.mts",
    "topoir": "node packages/cli/dist/bin.js",
    "benchmark:generalization": "tsx benchmarks/generalization.mts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vitest": "^3.2.0"
  }
}
