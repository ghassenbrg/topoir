{
  "name": "@topoir/cli",
  "version": "0.1.0-alpha.0",
  "description": "Agent-native command-line interface for the TopoIR visual compiler",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "publishConfig": { "access": "public" },
  "files": ["dist"],
  "bin": {
    "topoir": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@topoir/sdk": "workspace:*",
    "@topoir/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2"
  }
}
