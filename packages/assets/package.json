{
  "name": "@topoir/assets",
  "version": "0.1.0-alpha.0",
  "description": "Offline SVG icon registry and local asset inventory for TopoIR",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "publishConfig": { "access": "public" },
  "files": ["dist", "NOTICE.md", "licenses"],
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@iconify-json/devicon": "1.2.65",
    "@iconify-json/lucide": "1.2.134",
    "@iconify-json/k8s": "1.2.0",
    "@xmldom/xmldom": "^0.9.8",
    "sharp": "^0.35.4",
    "yaml": "^2.8.1"
  },
  "devDependencies": { "@types/node": "^26.6.2", "tsup": "^8.5.0", "typescript": "^6.0.0" }
}
