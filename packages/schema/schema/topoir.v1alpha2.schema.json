        "status": {
          "enum": [
            "normal",
            "success",
            "failure",
            "warning"
          ]
        },
        "step": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "direction": {
          "enum": [
            "forward",
            "back",
            "both",
            "none"
          ]
        },
        "style": {
          "enum": [
            "solid",
            "dashed",
            "dotted"
          ]
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "order": {
          "type": "integer",
          "minimum": -100000,
          "maximum": 100000
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "flow": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "style": {
          "enum": [
            "solid",
            "dashed",
            "dotted"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": -100000,
          "maximum": 100000
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "annotation": {
      "type": "object",
      "required": [
