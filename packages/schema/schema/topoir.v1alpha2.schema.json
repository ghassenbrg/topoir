        },
        "kind": {
          "enum": [
            "request",
            "response",
            "read",
            "write",
            "publish",
            "consume",
            "replicate",
            "authenticate",
            "authorize",
            "stream",
            "sync",
            "async",
            "control",
            "data",
            "dependency",
            "network"
