        "kind": {
          "enum": [
            "note",
            "warning",
            "callout"
          ]
        },
        "text": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "anchor": {
          "$ref": "#/$defs/id"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "order": {
          "type": "integer",
          "minimum": -100000,
          "maximum": 100000
        },
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fill": {
              "type": "string",
              "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+)$"
            },
            "stroke": {
              "type": "string",
              "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+)$"
            },
            "text": {
              "type": "string",
              "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+)$"
            }
          }
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "designTokens": {
      "type": "object",
      "additionalProperties": false,
      "description": "Design tokens for this view. Every field overrides the base named by `extends`.",
