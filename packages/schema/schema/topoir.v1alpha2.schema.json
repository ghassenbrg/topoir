                },
                "stroke": {
                  "type": "string",
                  "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+)$"
                },
                "text": {
                  "type": "string",
                  "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+)$"
                }
              }
