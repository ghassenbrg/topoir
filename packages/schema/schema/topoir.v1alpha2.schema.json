{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://topoir.dev/schema/v1alpha2.json",
  "title": "TopoIR DiagramWorkspace v1alpha2",
  "description": "The target workspace envelope. A workspace holds reusable entities, one or more family models, and views that project a model for a purpose. Only families this build implements are accepted; an unimplemented family is rejected rather than silently producing nothing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "models",
    "views"
  ],
  "properties": {
    "apiVersion": {
      "const": "topoir.dev/v1alpha2"
    },
    "kind": {
      "const": "DiagramWorkspace"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/model"
      }
    },
    "styles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/style"
      }
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/workspaceView"
      }
    },
    "viewSets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/viewSet"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
      "minLength": 1,
      "maxLength": 128
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "color": {
      "type": "string",
      "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+)$"
    },
    "paint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fill": {
          "type": "string",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+)$"
        },
        "stroke": {
          "type": "string",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+)$"
        },
        "text": {
          "type": "string",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+)$"
        }
      }
    },
    "direction": {
      "enum": [
        "right",
        "left",
        "down",
        "up"
      ]
    },
    "metadata": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "type": "string",
          "maxLength": 8192
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 512
          }
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "kind": {
          "enum": [
            "client",
            "service",
            "api",
            "worker",
            "database",
            "cache",
            "queue",
            "stream",
            "object-storage",
            "filesystem",
            "gateway",
            "load-balancer",
            "firewall",
            "identity-provider",
            "vm",
            "container",
            "pod",
            "kubernetes-service",
            "function",
            "cloud-service",
            "external-system",
            "generic"
          ]
        },
        "group": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "technology": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "icon": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+:[A-Za-z0-9_./-]+$"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "order": {
          "type": "integer",
          "minimum": -100000,
          "maximum": 100000
        },
        "visual": {
          "$ref": "#/$defs/nodeVisual"
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "entity": {
          "$ref": "#/$defs/id"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "nodeVisual": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shape": {
          "enum": [
            "auto",
            "card",
            "icon",
            "cylinder",
            "stack",
            "pill",
            "diamond",
            "image"
          ]
        },
        "emphasis": {
          "enum": [
            "primary",
            "secondary",
            "muted"
          ]
        },
        "status": {
          "enum": [
            "normal",
            "success",
            "failure",
            "warning"
          ]
        },
        "badge": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "asset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "assets": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "portLabels": {
          "enum": [
            "hidden",
            "inside"
          ]
        }
      }
    },
    "port": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "side": {
          "enum": [
            "north",
            "east",
            "south",
            "west",
            "auto"
          ]
        },
        "kind": {
          "enum": [
            "input",
            "output",
            "bidirectional"
          ]
        },
        "protocol": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "order": {
          "type": "integer"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "kind": {
          "enum": [
            "system",
            "environment",
            "cloud",
            "region",
            "zone",
            "network",
            "vpc",
            "subnet",
            "kubernetes-cluster",
            "namespace",
            "deployment",
            "security-boundary",
            "external-zone",
            "logical"
          ]
        },
        "parent": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "technology": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "icon": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+:[A-Za-z0-9_./-]+$"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "order": {
          "type": "integer",
          "minimum": -100000,
          "maximum": 100000
        },
        "layout": {
          "$ref": "#/$defs/groupLayout"
        },
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fill": {
              "type": "string",
              "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+)$"
            },
            "stroke": {
              "type": "string",
              "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+)$"
            },
            "text": {
              "type": "string",
              "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+)$"
            },
            "emphasis": {
              "enum": [
                "primary",
                "secondary",
                "muted"
              ]
            }
          }
        },
        "entity": {
          "$ref": "#/$defs/id"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "groupLayout": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "auto",
            "layered",
            "row",
            "column",
            "grid",
            "pack"
          ]
        },
        "direction": {
