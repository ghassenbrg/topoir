                  "type": "string",
                  "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+)$"
                },
                "text": {
                  "type": "string",
                  "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+)$"
                }
              }
            }
          }
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "element"
      ],
      "properties": {
        "model": {
          "$ref": "#/$defs/id"
        },
        "element": {
          "$ref": "#/$defs/id"
        }
      },
      "description": "A cross-model element reference. Local family references are plain element IDs."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "locator"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "repository",
            "manifest",
            "trace",
            "document",
            "conversation",
            "other"
          ]
        },
        "locator": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "revision": {
          "type": "string"
        },
        "contentHash": {
          "type": "string"
        }
      },
      "description": "Metadata only. The compiler never fetches a source."
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "relation"
        ],
        "properties": {
          "source": {
            "$ref": "#/$defs/id"
          },
          "pointer": {
            "type": "string"
          },
          "relation": {
            "enum": [
              "observed",
              "inferred",
              "assumed"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      },
      "description": "How a fact came to be known. Observed, inferred and assumed are kept distinct."
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "description": "A reusable real-world thing. One entity can appear in several models in different roles."
    },
    "architectureBody": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "flows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flow"
          }
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/annotation"
          }
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "id",
        "family",
        "body"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "familyVersion": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "id": true,
            "familyVersion": true,
            "title": true,
            "description": true,
            "family": {
              "const": "architecture"
            },
            "body": {
              "$ref": "#/$defs/architectureBody"
            }
          }
        }
      ],
      "description": "A model's body is selected by its family. Only families this build implements are accepted."
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "$ref": "#/$defs/projectionSelector"
        },
        "exclude": {
          "$ref": "#/$defs/projectionSelector"
        },
        "edgePolicy": {
          "enum": [
            "induced",
            "exact"
          ],
          "description": "induced adds relationships between visible endpoints; exact retains only what was selected and never adds one."
        },
        "ancestorPolicy": {
          "enum": [
            "retain",
            "summarize"
          ]
        },
        "collapse": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "element",
              "mode"
            ],
            "properties": {
              "element": {
                "$ref": "#/$defs/id"
              },
              "mode": {
                "const": "summary"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "occurrences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "element"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "element": {
                "$ref": "#/$defs/id"
              },
              "role": {
                "enum": [
                  "primary",
                  "detail",
                  "repeated"
                ]
              },
              "label": {
                "type": "string"
              },
              "detail": {
                "enum": [
                  "minimal",
                  "standard",
                  "full"
                ]
              }
            }
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relationship"
            ],
            "properties": {
              "relationship": {
                "$ref": "#/$defs/id"
              },
              "from": {
                "$ref": "#/$defs/id"
              },
              "to": {
                "$ref": "#/$defs/id"
              }
            }
          },
          "description": "Required when a relationship endpoint has more than one candidate occurrence."
        }
      }
    },
    "projectionSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "tags": {
          "$ref": "#/$defs/tags"
        }
      }
    },
    "medium": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "page",
            "slide",
            "canvas",
            "screen"
          ]
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "padding": {
          "type": "number",
          "minimum": 0
        },
        "minTextSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fit": {
          "enum": [
            "contain",
            "paginate"
          ]
        },
        "dpi": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "description": "Legibility is a property of a drawing at a size, so the size is declared."
    },
    "constraint": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "strength": {
          "enum": [
            "required",
            "preferred"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "id": true,
            "strength": true,
            "priority": true,
            "type": {
              "const": "order"
            },
            "items": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "axis": {
              "enum": [
                "x",
                "y"
              ]
            }
          },
          "required": [
            "items"
          ]
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": true,
            "strength": true,
            "priority": true,
            "type": {
              "const": "place-relative"
            },
            "subject": {
              "$ref": "#/$defs/id"
            },
            "reference": {
              "$ref": "#/$defs/id"
            },
            "side": {
              "enum": [
                "above",
                "below",
                "left",
                "right"
              ]
            },
            "gap": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "subject",
            "reference",
            "side"
          ]
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": true,
            "strength": true,
            "priority": true,
            "type": {
              "const": "align"
            },
            "items": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "axis": {
              "enum": [
                "x",
                "y"
              ]
            }
          },
          "required": [
            "items",
            "axis"
          ]
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": true,
            "strength": true,
            "priority": true,
            "type": {
              "const": "group"
            },
            "items": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          },
          "required": [
            "items"
          ]
        }
      ],
      "description": "A required constraint that cannot be satisfied is an error, not a preference that was outvoted."
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "question": {
              "type": "string"
            },
            "audience": {
              "enum": [
                "engineering",
                "executive",
                "presentation",
                "learning"
              ]
            },
            "takeaway": {
              "type": "string"
            },
            "focus": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "story": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        "medium": {
          "$ref": "#/$defs/medium"
        },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pack": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "variant": {
              "type": "string"
            },
            "tokens": {
              "$ref": "#/$defs/designTokens"
            }
          }
        },
        "composition": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strategy": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "candidates": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "direction": {
              "$ref": "#/$defs/direction"
            }
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint"
          }
        },
        "contentPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "detail": {
              "enum": [
                "minimal",
                "standard",
                "full"
              ]
            },
            "required": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "element"
                ],
                "properties": {
                  "element": {
                    "$ref": "#/$defs/id"
                  },
                  "field": {
                    "type": "string"
                  }
                }
              },
              "description": "Content that may never be omitted or abbreviated to make a diagram fit."
            }
          }
        }
      }
    },
    "workspaceView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "model"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "model": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "showLegend": {
          "type": "boolean"
        },
        "projection": {
          "$ref": "#/$defs/projection"
        },
        "presentation": {
          "$ref": "#/$defs/presentation"
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tokens"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "extends": {
          "$ref": "#/$defs/id"
        },
        "tokens": {
          "$ref": "#/$defs/designTokens"
        }
      }
    },
    "viewSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "views"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "title": {
          "type": "string"
        },
        "sharedStyle": {
          "$ref": "#/$defs/id"
        }
      }
    }
  }
}
