        "extends": {
          "$ref": "#/$defs/id"
        },
        "language": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "component": {
              "enum": [
                "card",
                "icon",
                "architectural",
                "sketch"
              ]
            },
            "header": {
              "enum": [
                "plain",
                "editorial",
                "rule"
              ]
            },
            "boundaries": {
              "enum": [
                "panel",
                "outline",
                "rail"
              ]
            },
            "connectorRadius": {
              "type": "number",
              "minimum": 0,
              "maximum": 48
            },
            "depth": {
              "type": "number",
              "minimum": 0,
              "maximum": 24
            },
            "iconSize": {
              "type": "number",
              "minimum": 8,
              "maximum": 160
            }
          }
        },
