{
  "name": "@topoir/schema",
  "version": "0.1.0-alpha.0",
  "description": "TopoIR semantic document schema, parser, and structural validation",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "schema"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./topoir.schema.json": "./schema/topoir.schema.json"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "generate": "tsx scripts/generate-workspace-types.mts --write"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsup": "^8.5.0",
    "typescript": "^6.0.0"
  }
}
